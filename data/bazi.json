  "note": "Файл поглотил interactions.json и добавил правила вывода столпов (ранее только в коде) и таблицу 12 фаз Ци (ранее отсутствовала).",
  "pillarRules": {
    "status": "VERIFIED",
    "year": {
      "formula": "index = mod(solarYear − 1984, 60)",
      "boundary": "lichun",
      "note": "Год меняется в Ли Чунь, а не 1 января."
    },
    "month": {
      "stemFormula": "mod(yearStemIndex*2 + ordinalFromYin + 2, 10)",
      "branchFormula": "mod(ordinalFromYin + 2, 12)",
      "ruleName": "五虎遁 (пять тигров)",
      "boundary": "jie"
    },
    "day": {
      "formula": "index = (JD_полдень − 11) mod 60",
      "note": "Считается от местного полудня; см. правило TZ-3."
    },
    "hour": {
      "branchFormula": "mod(floor((localHour + 1) / 2), 12)",
      "stemFormula": "mod(dayStemIndex*2 + hourBranchIndex, 10)",
      "ruleName": "五鼠遁 (пять крыс)",
      "conflictRef": "K4"
    }
  },
  "ziHourConflict": {
    "status": "UNRESOLVED",
