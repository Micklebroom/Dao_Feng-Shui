{
  "$schema": "golden_cases.v1",
  "specVersion": "1.0.0",
  "phase": "PHASE 3 — GOLDEN TESTS",
  "purpose": "Детерминированные эталонные случаи для критических VERIFIED алгоритмов. Ожидаемые значения взяты из внешних опубликованных источников либо являются структурными инвариантами, доказуемыми независимо от реализации.",
  "policy": {
    "noSelfConfirmation": "Значения expected_output НЕ берутся из вывода нашего кода, если только это не структурный инвариант. Для астрономии и звёздных карт используются опубликованные эталоны.",
    "toleranceRule": "Для величин с объявленной ограниченной точностью (моменты солнечных терминов) указывается tolerance; сравнение по допуску, а не на точное равенство.",
    "notVerifiedExcluded": "Для алгоритмов со статусом NOT_VERIFIED golden-тесты НЕ создаются: сравнивать не с чем. Вместо этого проверяются только контракты (см. contractTests)."
  },
  "statusLegend": {
    "GOLDEN": "эталон из внешнего опубликованного источника",
    "INVARIANT": "структурный инвариант, доказуемый независимо от реализации",
    "REGRESSION": "закрепляет исправленный дефект"
  },
